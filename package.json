{
  "name": "balance",
  "version": "0.1.0",
  "description": "Трекер расходов на ремонт квартиры",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build -w @balance/shared && concurrently -n shared,api,web -c gray,magenta,cyan \"npm run dev -w @balance/shared\" \"npm run dev -w @balance/api\" \"npm run dev -w @balance/web\"",
    "build": "npm run build -w @balance/shared && npm run build -w @balance/api && npm run build -w @balance/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
