NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://balance:balance@localhost:5432/balance?schema=public
CORS_ORIGIN=http://localhost:3000

# --- JWT (секреты разные, ≥ 32 символов): openssl rand -base64 48 ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
